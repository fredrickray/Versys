# Copy to the deploy host as ~/versys/.env.deploy (never commit real secrets).
NODE_ENV=production
APP_NAME=versys

API_PORT=3000
REALTIME_PORT=3001
API_HOST_PORT=3000
REALTIME_HOST_PORT=3001

# Set per Instacloud/compute service (same Dockerfile image):
# PROCESS=api | realtime | worker
PROCESS=api

# Prefer full URLs on managed hosts (Neon, Railway, Upstash, etc.):
# DATABASE_URL=postgresql://user:pass@host:5432/versys?sslmode=require
# REDIS_URL=rediss://default:pass@host:6379
#
# With docker-compose.deploy.yml, compose builds the URL from these:
DATABASE_USER=versys
DATABASE_PASSWORD=change-me-strong
DATABASE_NAME=versys
DATABASE_SSL=false
DATABASE_LOGGING=false

REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret!
JWT_REFRESH_TTL=7d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

SMS_PROVIDER=mock
SMS_TERMII_API_KEY=
SMS_TERMII_SENDER_ID=
SMS_TERMII_BASE_URL=https://api.ng.termii.com
SMS_TERMII_OTP_CHANNEL=dnd
SMS_TERMII_ALERT_CHANNEL=generic

CORS_ORIGINS=https://your-staging-frontend.example

LOCATION_RETENTION_DAYS=30
RATE_LIMIT_ALERTS_PER_HOUR=10
RATE_LIMIT_WEBHOOKS_PER_MINUTE=60
CHANNEL_WEBHOOK_SECRET=change-me-webhook-secret

EVENT_MODE=false
EVENT_NAME=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=VERSYS under maintenance — use radio / dispatcher hotline

# Phase 10 — real Level-4 agency phones (required before live event seed)
LEVEL4_PHONE_DSS=
LEVEL4_PHONE_DSS_HUNTERS=
LEVEL4_PHONE_MILITARY=
LEVEL4_PHONE_POLICE=
LEVEL4_PHONE_FIRE_SERVICE=

# Image is set by the deploy workflow / shell (not usually in this file):
# VERSYS_IMAGE=ghcr.io/<github-owner>/versys:staging
