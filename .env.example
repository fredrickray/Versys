NODE_ENV=development
APP_NAME=versys

API_PORT=3000
REALTIME_PORT=3001

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=versys
DATABASE_PASSWORD=versys
DATABASE_NAME=versys
DATABASE_SSL=false
DATABASE_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
JWT_REFRESH_TTL=7d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

FCM_ENABLED=false
SMS_PROVIDER=mock
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

LOCATION_RETENTION_DAYS=30
RATE_LIMIT_ALERTS_PER_HOUR=10

RATE_LIMIT_WEBHOOKS_PER_MINUTE=60
CHANNEL_WEBHOOK_SECRET=

# Drill / staging timer overrides (ms). Leave blank for production defaults.
# ESCALATION_PROMPT_AFTER_MS=30000
# ESCALATION_AUTO_AFTER_PROMPT_MS=60000
# ESCALATION_DISPATCHER_RESOLVE_AFTER_MS=300000
# ESCALATION_RECONCILER_INTERVAL_MS=15000

# Phase 5 — event freeze
EVENT_MODE=false
EVENT_NAME=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=VERSYS under maintenance — use radio / dispatcher hotline
