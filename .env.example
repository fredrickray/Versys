NODE_ENV=development
APP_NAME=versys

API_PORT=3000
REALTIME_PORT=3001

# Which Nest process to run in Docker / Instacloud (same image):
#   api | realtime | worker
PROCESS=api

# Preferred connection strings (deploy / managed Postgres & Redis)
DATABASE_URL=postgresql://versys:versys@localhost:5433/versys
# DATABASE_SSL=true   # or ?sslmode=require on the URL
DATABASE_LOGGING=false

REDIS_URL=redis://localhost:6379/0

# Legacy discrete fields still work if DATABASE_URL / REDIS_URL are empty:
# DATABASE_HOST=localhost
# DATABASE_PORT=5433
# DATABASE_USER=versys
# DATABASE_PASSWORD=versys
# DATABASE_NAME=versys
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
JWT_REFRESH_TTL=7d

OTP_TTL_SECONDS=300
OTP_LENGTH=6

FCM_ENABLED=false
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private_key from the JSON; keep \n escaped as a single line
FIREBASE_PRIVATE_KEY=

# mock | termii  (aggregator is deprecated)
SMS_PROVIDER=mock
SMS_TERMII_API_KEY=
SMS_TERMII_SENDER_ID=
SMS_TERMII_BASE_URL=https://api.ng.termii.com
SMS_TERMII_OTP_CHANNEL=dnd
SMS_TERMII_ALERT_CHANNEL=generic

# Cloudinary — incident photo uploads (POST /v1/media/upload). Missing => 503 cloudinary_not_configured
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=versys/incidents

CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:3002

LOCATION_RETENTION_DAYS=30
RATE_LIMIT_ALERTS_PER_HOUR=10

RATE_LIMIT_WEBHOOKS_PER_MINUTE=60
CHANNEL_WEBHOOK_SECRET=

# Drill / staging timer overrides (ms). Leave blank for production defaults.
# ESCALATION_PROMPT_AFTER_MS=30000
# ESCALATION_AUTO_AFTER_PROMPT_MS=60000
# ESCALATION_DISPATCHER_RESOLVE_AFTER_MS=300000
# ESCALATION_RECONCILER_INTERVAL_MS=15000

# Phase 5 — event freeze
EVENT_MODE=false
EVENT_NAME=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=VERSYS under maintenance — use radio / dispatcher hotline

# Phase 10 — Level-4 agency phones (E.164). Leave blank to keep seed placeholders.
# LEVEL4_PHONE_DSS=+234…
# LEVEL4_PHONE_DSS_HUNTERS=+234…
# LEVEL4_PHONE_MILITARY=+234…
# LEVEL4_PHONE_POLICE=+234…
# LEVEL4_PHONE_FIRE_SERVICE=+234…
